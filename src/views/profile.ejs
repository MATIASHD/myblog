<h1>Profile</h1>
<div class="row justify-content-center align-items-center mt-5">
    <div class="col-sm-12 col-md-6">
        <h1 class="text-center">Perfil</h1>
        <figure>
            <figcaption>
                <img src="" alt="">
            </figcaption>
        </figure>
        <div class="mb-3">
            <label for="name" class="form-label">Nombres:</label>
            <p><%= user.name %></p>
        </div>
        <div class="mb-3">
            <label for="surname" class="form-label">Nombres:</label>
            <p><%= user.surname %></p>
        </div> 
        <div class="mb-3">
            <label for="nick" class="form-label">Nombres:</label>
            <p><%= user.nick %></p>
        </div> 
        <div class="mb-3">
            <label for="email" class="form-label">Nombres:</label>
            <p><%= user.email %></p>
        </div> 
        <div class="mb-3">
            <label for="bio" class="form-label">Nombres:</label>
            <p><%= user.bio %></p>
        </div> 
        <div class="mb-3">
            <form action="/dashboard/user/update/<%= user.id %>" method="post" enctype="multipart/form-data">
                <button type="submit" class="btn btn-primary">Editar</button>
            </form>
        </div>
   </div>
</div>