<div class="container my-5 fs-4">
    <div class="row">
        <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
            <h1 class="text-center">Perfil</h1>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-4 col-lg-4 mx-auto d-block">
            <div class="card border-0 mt-4 ">
                <figure class="mx-auto">
                    <% if (user.perfil_picture.media.startsWith("http://") || user.perfil_picture.media.startsWith("https://")) { %>
                    <img src="<%= user.perfil_picture.media %>" class="figure-img rounded shadow-sm img-fluid" alt="<%= user.perfil_picture.alt %>">
                    <% } else {%>
                    <img src="/assets/upload/<%= user.perfil_picture.media %>" class="figure-img rounded shadow-sm img-fluid" alt="<%= user.perfil_picture.alt %>">
                    <% } %>
                    <figcaption>
                        <p class="text-body-tertiary d-none roboto-font fs-6 fw-normal"><small><%= user.perfil_picture.figcaption %></small></p>
                    </figcaption>
                </figure>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-4 col-lg-4 mx-auto text-body-tertiary roboto-font">
            <div class="mb-0">
              <label for="name" class="form-label fs-6">Estado:  <% if (user.perfil_activo == 1) { %>
                <span class="badge text-bg-primary">Activo</span>
              <% } else { %>
                <span class="badge text-bg-secondary">Deshabilitado</span>
              <% } %>
              </label>
            </div>
            <div class="mb-0">
                <label for="name" class="form-label fs-6">Nombres: <span class="text-dark fw-bold"><%= user.username %> <%= user.lastname %></span></label>
            </div>
            <div class="mb-0">
                <label for="email" class="form-label fs-6">Email: <span class="text-dark fw-bold"><%= user.email %></span></label>
            </div>
            <div class="mb-0">
              <label for="email" class="form-label fs-6">Ocupación: <span class="text-dark fw-bold"><%= user.ocupacion %></span></label>
            </div>
            <div class="mb-0">
              <label for="email" class="form-label fs-6">Bio: <span class="text-dark fw-bold"><%= user.bio %></span></label>
            </div>
            <div class="mb-0">
                <div class="row">
                    <div class="d-grid gap-2 d-md-flex mt-2 justify-content-md-end">
                        <form action="/dashboard/user/update/<%= user.id %>" method="get" enctype="multipart/form-data">
                            <button type="submit" class="btn btn-primary">Editar</button>
                        </form>
                        <form action="/dashboard/user/delete/<%= user.id %>?_method=DELETE" method="post" enctype="multipart/form-data">
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
