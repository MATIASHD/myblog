<div class="container my-5 fs-4">
    <div class="row">
        <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
            <h1 class="text-center">Perfil</h1>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-11 col-lg-7 mx-auto d-block">
            <div class="card border-0 mt-4 ">
                <figure class="mx-auto">
                    <% if (user.userimg.startsWith("http://") || user.userimg.startsWith("https://")) { %>
                    <img src="<%= article.img %>" class="figure-img rounded shadow-sm img-fluid" alt="">
                    <% } else {%>
                    <img src="/assets/upload/<%= user.userimg %>" class="figure-img rounded shadow-sm img-fluid" alt="">
                    <% } %>
                    <figcaption>
                        <p class="text-body-tertiary roboto-font fs-6 fw-normal"><small>Implica asumir la responsabilidad y el ownership de tu</small></p>
                    </figcaption>
                </figure>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
            <div class="mb-3">
                <label for="name" class="form-label">Nombres: <span><%= user.username %></span></label>
            </div>
            <div class="mb-3">
                <label for="surname" class="form-label">Apellido: <span><%= user.surname %></span></label>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email: <span><%= user.email %></span></label>
            </div> 
            <div class="mb-3">
                <div class="row">
                    <div class="d-grid gap-2 d-md-flex mt-2 justify-content-md-end">
                        <form action="/dashboard/user/update/<%= user.id %>" method="get" enctype="multipart/form-data">
                            <button type="submit" class="btn btn-primary">Editar</button>
                        </form>
                        <form action="/dashboard/user/delete/<%= user.id %>?_method=DELETE" method="post" enctype="multipart/form-data">
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                        </form>
                    </div>
                </div>   
            </div>
        </div>
    </div>
</div>
