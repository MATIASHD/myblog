<div class="row container mx-auto">
    <div class="col-md-11">
        <div class="row">
            <h1>Overview</h1>
        </div>
        <div class="row my-5">
            <div class="col-12">
                <h2>View</h2>
            </div>
            <div class="col-md-3">
                <div class="card border-0 p-2 bg-success text-white">
                    <div class="row">
                        <div class="col-12">
                            <h6>VISITAS</h6>
                        </div>
                        <div class="col-12 text-end">
                            <span class="fs-1">17</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 p-2 bg-primary text-white">
                    <div class="row">
                        <div class="col-12">
                            <h6>USUARIOS</h6>
                        </div>
                        <div class="col-12 text-end">
                            <span class="fs-1">1.024</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 p-2 bg-warning text-white">
                    <div class="row">
                        <div class="col-12">
                            <h6>PUBLICACIONES</h6>
                        </div>
                        <div class="col-12 text-end">
                            <span class="fs-1"><%= articleCount %></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 p-2 bg-info-subtle">
                    <div class="row">
                        <div class="col-12">
                            <h6>MENSAJES</h6>
                        </div>
                        <div class="col-12 text-end">
                            <span class="fs-1">500</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--form-->
        <div class="row">
            <div class="row">
                <h2>Entradas</h2>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Titulo</th>
                                <th scope="col">Subtitulo</th>
                                <th scope="col">Estado</th>
                                <th scope="col">Tiempo</th>
                            </tr>
                        </thead>
                            <tbody>
                              <% for (let i = 0; i < post.length; i++) { %>
                                <tr>
                                    <th scope="row"><%= post[i].title %></th>
                                    <td><%= post[i].subtitle %></td>
                                    <td><% if (post[i].draft == 1) { %>
                                      <span class="badge text-bg-secondary">Borrador</span>
                                    <% } else { %>
                                      <span class="badge text-bg-primary">Publicado</span>
                                    <% } %></td>
                                    <td><%= post[i].created_at %></td>
                                </tr>
                              <% } %>
                            </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
