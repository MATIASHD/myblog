<div class="col-sm-12 col-md-6">
    <h1 class="text-center">Restablecer contraseña</h1>
    <form action="/dashboard/user/resetpassword" method="put" id="loginForm">
        <div class="mb-3">
            <label for="password" class="form-label">Actualizar contraseña</label>
            <input type="password" class="form-control" id="password" aria-describedby="password">
        </div>
        <div class="mb-3">
            <label for="password1" class="form-label">Nueva contraseña</label>
            <input type="password1" class="form-control" id="password1" aria-describedby="password1">
        </div>
        <div class="mb-3">
            <label for="password2" class="form-label">Vuelva a repetir la contraseña</label>
            <input type="password2" class="form-control" id="password2" aria-describedby="password2">
        </div>
        <button type="submit" class="btn btn-primary">Restablecer contraseña</button>
    </form>
</div>

