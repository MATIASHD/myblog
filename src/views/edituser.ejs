<h1>EDit user</h1>
<div class="row justify-content-center align-items-center mt-5">
    <div class="col-sm-12 col-md-6">
        <h1 class="text-center">Editar usuario</h1>
        <form action="/dashboard/user/update/<%= user.id %>" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="name" class="form-label">Nombres</label>
                <input type="text" name="name" value="<%= user.name %>" class="form-control" id="name" aria-describedby="name">
            </div>
            <div class="mb-3">
                <label for="surname" class="form-label">Apellidos</label>
                <input type="text" name="surname" value="<%= user.surname %>" class="form-control" id="surname" aria-describedby="surname">
            </div>
            <div class="mb-3">
                <label for="nick" class="form-label">Nick</label>
                <input type="text" name="nick" value="<%= user.nick %>" class="form-control" id="nick" aria-describedby="nick">
            </div>
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" name="email" value="<%= user.email %>" class="form-control" id="email" aria-describedby="emailHelp">
            </div>
            <div class="mb-3">
                <label for="bio" class="form-label">Bio</label>
                <textarea class="form-control" value="<%= user.bio %>" id="bio" name="bio" rows="3"></textarea>
              </div>
              <div class="mb-3">
                <label for="image" class="form-label">Imagen</label>
                <input class="form-control" name="image" accept="image/*" type="file" id="image">
            </div>  
            <div class="mb-3">
              <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>            
   </div>
</div>