<div class="container my-5">
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <h1 class="fw-bold roboto-font text-center"> Tags</h1>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <form action="/dashboard/tags/create" method="post">
          <div class="row">
          <div class="col-md-9">
            <input type="text" name="name" class="form-control mr-2" id="exampleInputEmail1" aria-describedby="emailHelp">
          </div>
          <div class="col-md-3">
            <button type="submit" class="ml-2 btn btn-primary">Agregar</button>
          </div>
        </div>
      </form>
    </div>
  </div>
  <div class="row my-5">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
    <% for (let i = 0; i < alltags.length; i++) { %>
      <div class="col-sm-1 col-md-1 col-lg-1">
        <span class="badge text-bg-primary">
          <div class="d-flex align-items-center ">
            <form action="/dashboard/tags/delete/<%= alltags[i].id %>?_method=DELETE" method="post">
              <%= alltags[i].nombre %><button type="submit" class="ms-1 btn-close" aria-label="Close"></button></span>
            </form>
          </div>
        </div>
     <% } %>
    </div>
  </div>
</div>
