<div class="row d-flex justify-content-center mt-4">
    <div class="col-md-11">
        <div class="row mb-3">
            <div class="col-12">
                <h1>Lista de usuario</h1>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-12">
                <form action="/dashboard/user/register" method="get">
                    <button type="submit" class="btn btn-primary btn-lg">Agregar usuario</button>
                </form>
            </div>
        </div>             
        <!--form-->
        <div class="row">
            <div class="col-md-12">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">Apellido</th>
                            <th scope="col">Email</th>
                            <th scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    <% user.forEach(user => { %>
                        <tr>
                            <td><%= user.username %></td>
                            <td><%= user.lastname %></td>
                            <td><%= user.email %></td>
                            <td>
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <form action="/dashboard/user/profile/<%= user.id %>" method="get">
                                        <button class="btn btn-primary me-md-2" type="submit">Perfil</button>
                                    </form>
                                    <!--<form action="" method="get">
                                        <button class="btn btn-danger" type="button">Borrar</button>
                                    </form>-->
                                </div>
                            </td>
                        </tr>
                    <% }) %>                          
                    </tbody>
                </table>
            </div>
        </div>
    </div>          
</div>
