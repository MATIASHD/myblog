<div class="col-sm-12 offset-md-3 col-md-6">
  <h1 class="text-center">Crear post</h1>
  <form action="/dashboard/post/create" method="post" enctype="multipart/form-data">
    <div class="mb-3">
      <label for="title" class="form-label">Titulo</label>
      <input type="text" name="title" class="form-control" id="title" aria-describedby="title">
    </div>
    <div class="mb-3">
      <label for="title" class="form-label">Subtitulo</label>
      <input type="text" name="subtitle" class="form-control" id="title" aria-describedby="title">
    </div>
    <div class="mb-3">
      <label for="estracto" class="form-label">introducción</label>
      <input type="text" name="estract" class="form-control" id="estracto" aria-describedby="estracto">
    </div>
    <div class="mb-3">
      <label for="image" class="form-label">Imagen</label>
      <input class="form-control" name="image" accept="image/*" type="file" id="image">
    </div>
    <div class="mb-3">
      <label for="floatingTextarea">Post</label>
      <textarea class="form-control" name="post" rows="10" cols="700" placeholder="Leave a comment here" id="floatingTextarea"></textarea>
    </div>
    <div class="mb-3">
      <div class="form-floating">
        <select class="form-select" name="author" id="floatingSelect" aria-label="Floating label select example">
          <option selected>Editorial</option>
          <% for (let i = 0; i < user.length; i++) { %>
          <option value="<%= user[i].id %>"><%= user[i].username %> <%= user[i].lastname %></option>
          <% } %>
        </select>
        <label for="floatingSelect">Autor</label>
      </div>
    </div>
    <div class="mb-3">
      <div class="form-floating">
        <select class="form-select" name="draft" id="floatingSelect" aria-label="Floating label select example">
          <option value="1" selected>Borrador</option>
          <option value="0">Publicar</option>
        </select>
        <label for="floatingSelect">Estado del post</label>
      </div>
    </div>
    <div class="mb-3">
      <button type="submit" class="btn btn-primary">Publicar</button>
    </div>
  </form>
</div>
