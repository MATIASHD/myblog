<div class="row my-5">
  <div class="col-lg-4 offset-lg-4">
    <div class="row d-flex align-items-center">
      <div class="col-md-3 col-xs-12 ">
        <figure class="figure my-1">
          <img src="../assets/img/WhatsApp Image 2024-02-01 at 19.30.26.jpeg" style="width: 150px;" class="figure-img img-fluid imagen-redondeada" alt="">
            <!--data source-->
          <figcaption class="figure-caption d-none">El edificio de la Bolsa de Comercio, pionero entre los "gigantes" del Bajo porteño. Foto: Guillermo Rodríguez Adami</figcaption>
        </figure>
      </div>
      <div class="col-md-9 col-xs-12">
        <h1 class="fs-3">Matias Arevalo</h1>
          <p class="">Soy desarrollador full stack web Jr, Me gusta crear productos accesibles para todos. Pensado a la persona como centro de nuestras propuestas, abarcando un gran espectro de la misma.</p>
          <a href="#">hey@matiasarevalo.com</a>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <hr>
      </div>
    </div>
      <% for (let i = 0; i < article.length; i++) { %>
      <div class="row">
        <div class="d-flex">
          <div class="col">
            <h5 class="mt-0"><%= article[i].title %></h5>
            <p><%= article[i].estract %></p>
            <a class="icon-link" href="/article/<%= article[i].id %>">
              Leer más
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
          <div class="justify-content-end">
          <% if (article[i].img.startsWith("http://") || article[i].img.startsWith("https://")) { %>
            <img src="<%= article[i].img %>" class="flex-shrink-0 figure-img img-card object-fit-cover img-fluid" alt="">
          <% } else {%>
            <img src="../assets/upload/<%= article[i].img %>" class="flex-shrink-0 figure-img img-card object-fit-cover img-fluid" alt="">
          <% } %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-12">
          <hr>
        </div>
      </div>
    <% } %>
  </div>
</div>
