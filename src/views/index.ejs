<div class="container">
  <div class="row">
    <div class="col-ms-12 col-md-11 col-lg-8 mx-auto  mb-4">

      <% for (let i = 0; i < user.length; i++) { %>
        <% if (user[i].perfil_activo == 1) { %>
          <div class="row">
            <div class="col-3">
                <div class="text-center">
                    <img src="../assets/upload/<%= user[i].perfil_picture.media %>" style="width: 150px; height: 150px;" class="img-fluid object-fit-cover rounded-circle" alt="<%= user[i].perfil_picture.alt %>">
                </div>
            </div>
            <div class="col-9">
                <h1 class="fw-bold mb-1"><%= user[i].username %> <%= user[i].lastname %></h1>
                <h3 class="fw-light mb-2"><%= user[i].ocupacion %></h3>
                <p class="fw-normal fst-normal lh-sm"><%= user[i].bio %></p>
                <h6 class="text-primary"><%= user[i].email %></h6>
            </div>
        </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>
<div class="container">
<div class="row">
  <% for (let i = 0; i < article.length; i++) { %>
    <% if (article[i].draft == 0) { %>
      <div class="col-ms-12 col-md-6 col-lg-4 mb-4">
        <div class="row">
          <div class="col-12 mb-2">
            <div class="card border-0 mb-2">
              <figure>
                  <% if (article[i].media[0].media.startsWith("http://") || article[i].media[0].media.startsWith("https://")) { %>
                    <img src="<%= article[i].media[0].media %>" style="height: 280px; width: 415px;" class="rounded object-fit-cover img-fluid shadow-sm"  alt="">
                  <% } else {%>
                    <img src="../assets/upload/<%= article[i].media[0].media %>" style="height: 280px; width: 415px;" class="rounded object-fit-cover img-fluid shadow-sm"  alt="">
                  <% } %>
                <!--data source-->
                <figcaption class="figure-caption d-none">El edificio de la Bolsa de Comercio, pionero entre los "gigantes" del Bajo porteño. Foto: Guillermo Rodríguez Adami</figcaption>
              </figure>
            </div>
          </div>
          <div class="col-12 mb-2">
            <div class="row">
              <div class="col-1">
                <% for (let j = 0; j < article[i].tags.length; j++) { %>
                  <span class="badge text-bg-secondary"><%= article[i].tags[j].nombre %></span>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-12">
            <a href="/article/<%= article[i].id %>"><h5><%= article[i].title %></h5></a>
          </div>
        </div>
      </div>
    <% } %>
  <% } %>
</div>
</div>
