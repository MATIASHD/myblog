<div class="container">
  <div class="row">
    <div class="col-ms-12 col-md-6 col-lg-4 mb-4 mx-auto">
      <h1 class="text-center">Galeria</h1>
    </div>
  </div>
  <div class="row">
    <% for (let i = 0; i < galeria.length; i++) { %>
      <div class="col-ms-12 col-md-6 col-lg-4 mb-4">
        <div class="row">
          <div class="col-12 mb-2">
              <div class="card border-0 shadow-sm">
                  <img src="https://cdn.dribbble.com/userupload/14432707/file/original-646916cf4efcd20705ba0de23b9a067b.jpg?resize=600x450" class="card-img-top" alt="...">
                  <div class="card-body">
                    <h5 class="card-title">Nombre de la imagen</h5>
                    <p class="card-text m-0"><span class="text-body-tertiary">Alt:</span> <%= galeria[i].alt %></p>
                    <p class="card-text m-0"><span class="text-body-tertiary">Figcaption:</span> <%= galeria[i].figcaption %></p>
                    <p class="card-text"><span class="text-body-tertiary">Ruta:</span> <%= galeria[i].media %> </p>
                    <p>
                      <div class="row">
                        <div class="d-grid gap-2 d-md-flex mt-2 justify-content-md-end">
                        <form method="get" enctype="multipart/form-data">
                          <button class="btn btn-primary" href="/dashboard/galery/update/<%= galeria[i].id %>" role="button">Editar</button>
                        </form>
                        <form action="/dashboard/galery/delete/<%= galeria[i].id %>?_method=DELETE" method="POST">
                          <button class="btn btn-outline-danger" type="submit">Borrar</button>
                        </form>
                        </div>
                      </div>
                    </p>
                  </div>
              </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>



