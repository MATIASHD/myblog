<div class="container my-5 article-font fs-4">
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <!--Title-->
      <h1 class="fw-bold roboto-font"> <%= article.title %></h1>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <h2 class="fw-normal fs-4"> <%= article.subtitle %></h2>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <ul class="nav fs-3 mini-share-bar">
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href=""><i class="fa-brands fa-x-twitter"></i></a></li>
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href=""><i class="fa-brands fa-facebook-f"></i></a></li>
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href=""><i class="fa-brands fa-instagram"></i></a></li>
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href=""><i class="fa-regular fa-envelope"></i></a></li>
      </ul>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto d-block">
      <div class="card border-0 mt-4 ">
        <figure class="mx-auto">
          <% if (article.img.startsWith("http://") || article.img.startsWith("https://")) { %>
          <img src="<%= article.img %>" class="figure-img rounded shadow-sm img-fluid" alt="">
          <% } else {%>
          <img src="../assets/upload/<%= article.img %>" class="figure-img rounded shadow-sm img-fluid" alt="">
          <% } %>
          <figcaption>
            <p class="text-body-tertiary roboto-font fs-6 fw-normal"><small>Implica asumir la responsabilidad y el ownership de tu</small></p>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <div class="row">
      <div class="col-2">
        <figure class="mx-auto">
          <% if (article.author.userimg.startsWith("http://") || article.author.userimg.startsWith("https://")) { %>
          <img src="<%= article.author.userimg %>" class="img-fluid rounded-circle m-0" alt="">
          <% } else {%>
          <img src="../assets/upload/<%= article.author.userimg %>" class="img-fluid rounded-circle m-0" alt="">
          <% } %>
          <figcaption>
            <p class="text-body-tertiary d-none roboto-font fs-6 fw-normal"><small>Implica asumir la responsabilidad y el ownership de tu</small></p>
          </figcaption>
        </figure>
      </div>
      <div class="col fs-6">
        <p class="m-0"><%= article.author.username %> <%= article.author.lastname %></p>
        <span class="text-secondary"> <%= article.created_at %></span>
      </div>
    </div>
    </div>
  </div>
  <%- article.content %>
</div>



