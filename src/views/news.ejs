<div class="container article-font fs-4">
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <!--Title-->
      <h1 class="fw-bold roboto-font"> <%= article.title %></h1>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <h2 class="fw-normal roboto-font fs-4"> <%= article.subtitle %></h2>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <ul class="nav fs-3 mini-share-bar">
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href="https://twitter.com/intent/tweet?url=URL_DEL_ARTICULO&text=<%= article.title %>" target="_blank"><i class="fa-brands fa-x-twitter"></i></a></li>
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href="https://www.facebook.com/sharer/sharer.php?u=URL_DEL_ARTICULO" target="_blank"><i class="fa-brands fa-facebook-f"></i></a></li>
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href="https://www.instagram.com/heymatiasarevalo/" target="_blank"><i class="fa-brands fa-instagram"></i></a></li>
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href=""><i class="fa-regular fa-envelope"></i></a></li>
        <li class="select-item"><a class="nav-link select-share text-body-secondary" href="https://www.linkedin.com/shareArticle?mini=true&url=URL_DEL_ARTICULO&title=<%= article.title %>&summary=RESUMEN_DEL_ARTICULO&source=matiasarevalo.com" target="_blank"><i class="fa-regular fa-envelope"></i></a></li>
      </ul>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto d-block">
      <div class="card border-0 mt-4 ">
        <figure class="mx-auto">
          <% if (article.media[0].media.startsWith("http://") || article.media[0].media.startsWith("https://")) { %>
          <img src="<%= article.media[0].media %>" class="figure-img rounded shadow-sm img-fluid" alt="<%= article.media[0].alt %>">
          <% } else {%>
          <img src="../assets/upload/<%= article.media[0].media %>" class="figure-img rounded shadow-sm img-fluid" alt="<%= article.media[0].alt %>">
          <% } %>
          <figcaption>
            <p class="text-body-tertiary roboto-font fs-6 fw-normal"><small><%= article.media[0].figcaption %></small></p>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <div class="row">
      <div class="col-3 d-flex justify-content-end">
        <figure class="m-0">
          <% if (article.author.perfil_picture.media.startsWith("http://") || article.author.perfil_picture.media.startsWith("https://")) { %>
          <img src="<%= article.author.perfil_picture.media %>" style="width: 65px; height: 65px;" class="img-fluid object-fit-cover rounded-circle m-0" alt="<%= article.author.perfil_picture.alt %>">
          <% } else {%>
          <img src="../assets/upload/<%= article.author.perfil_picture.media %>" style="width: 65px; height: 65px;" class="img-fluid object-fit-cover rounded-circle m-0" alt="<%= article.author.perfil_picture.alt %>">
          <% } %>
          <figcaption>
            <p class="text-body-tertiary d-none roboto-font fs-6 fw-normal"><small><%= article.author.perfil_picture.figconfig %></small></p>
          </figcaption>
        </figure>
      </div>
      <div class="col roboto-font fs-6">
        <div class="row">
          <p class="m-0"><%= article.author.username %> <%= article.author.lastname %></p>
          <span class="text-secondary"> <%= article.created_at %></span>
        </div>
      </div>
    </div>
    </div>
  </div>
  <%- article.content %>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <hr/>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <% for (let i = 0; i < article.tags.length; i++) { %>
        <span class="badge text-bg-secondary roboto-font"><%= article.tags[i].nombre %></span>
      <% } %>
    </div>
  </div>
</div>



