<div class="container my-5">
  <div class="row">
    <div class="col-sm-12 col-md-11 col-lg-7 mx-auto">
      <div class="row">
        <div class="col-ms-12 col-md-12 col-lg-12">
          <h1 class="text-center">Restablecer contraseña</h1>
        </div>
      </div>
      <div class="row">
        <div class="col-ms-12 col-md-12 col-lg-12 my-2">
          <p class="text-center">Ingrese su correo, y le enviaremos un email con los pasos a seguir</p>
        </div>
      </div>
      <div class="row">
        <div class="col-ms-12 col-md-12 col-lg-12">
          <form action="/dashboard/user/resetpassword" method="put" id="loginForm">
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" aria-describedby="email">
            </div>
            <a type="submit" class="btn btn-primary">Enviar correo</a>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
